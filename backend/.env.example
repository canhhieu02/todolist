# Sao chép file này thành .env và điền giá trị thực
# Copy this file to .env and fill in the actual values

# MongoDB connection string
MONGODB=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Port server lắng nghe
PORT=5001

# Môi trường: development | production
NODE_ENV=development

# JWT Secret - PHẢI là chuỗi ngẫu nhiên, đủ dài, khó đoán
# Tạo bằng lệnh: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-very-strong-random-secret-here

# (production only) URL của frontend để CORS
# FRONTEND_URL=https://yourdomain.com
